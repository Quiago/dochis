[Unit]
Description=Directorio de médicos en español (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
User=dochis
WorkingDirectory=/opt/dochis/.next/standalone
EnvironmentFile=/etc/dochis.env
Environment=NODE_ENV=production PORT=3000 HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
