{
  "name": "medicos-en-espanol",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:reset": "docker compose down -v && docker compose up -d --wait && node --env-file-if-exists=.env.local scripts/migrate.ts --seed"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.38.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.40.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.13",
    "next": "^16.3.5",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "typescript": "5.9",
    "vitest": "^5.0.1"
  }
}
