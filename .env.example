# Copia este archivo a .env.local (desarrollo) o /etc/dochis.env (EC2). Nunca lo subas con valores.

# PostgreSQL. En local: docker compose up -d. En RDS agrega ?sslmode=require a cada URL.
# Rol app_writer: escrituras desde rutas de servidor.
DATABASE_URL=postgres://app_writer:writer_local@localhost:5433/dochis
# Rol web_reader: solo lee las vistas públicas.
DATABASE_READER_URL=postgres://web_reader:reader_local@localhost:5433/dochis
# Admin (dueño del esquema): solo para npm run db:migrate. En RDS es el usuario maestro.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/dochis

# URL pública del sitio (SEO y enlaces)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AWS. En la EC2 las credenciales vienen del rol de la instancia: no pongas claves aquí.
AWS_REGION=eu-north-1
# WhatsApp Cloud API de Meta (developers.facebook.com → tu app → WhatsApp → API Setup)
# Token permanente de un System User; ID del número del bot (no es el teléfono)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret (App settings → Basic): valida la firma X-Hub-Signature-256 del webhook
WHATSAPP_APP_SECRET=
# Lo inventas tú y lo pegas en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# Número del bot en formato internacional sin "+", p. ej. 971500000000 (enlace wa.me de CONFIRMAR)
NEXT_PUBLIC_BOT_NUMBER=

# Límites del login (el bot responde a cada código: 1.000 respuestas gratis al mes)
OTP_ALLOWED_PREFIXES=+971
OTP_DAILY_CAP=200
# Secreto que se mezcla con el hash de los códigos. Genera con: openssl rand -base64 32
OTP_PEPPER=

# Sesiones (cookie firmada con jose). Genera con: openssl rand -base64 32
SESSION_SECRET=

# Encabezado secreto que CloudFront envía al origen; Caddy rechaza lo demás. Genera con: openssl rand -hex 24
ORIGIN_SECRET=

# Lo usa la Lambda del cron para llamar a /api/cron/*
CRON_SECRET=

# Resend (solo fallback de correo)
RESEND_API_KEY=
EMAIL_FROM=
