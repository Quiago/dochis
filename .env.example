# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Salta RLS: nunca la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (SEO y enlaces)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Número del bot en formato internacional sin "+", p. ej. 971500000000
NEXT_PUBLIC_BOT_NUMBER=

# Sesiones (cookie firmada con jose). Genera con: openssl rand -base64 32
SESSION_SECRET=

# Vercel Cron (protege las rutas de cron)
CRON_SECRET=

# Resend (solo fallback de correo)
RESEND_API_KEY=
EMAIL_FROM=
